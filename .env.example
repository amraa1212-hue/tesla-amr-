# Copy to .env.local and fill in from Supabase: Project → Connect (or Settings → API Keys).
# Both are public values. Never put the secret / service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
